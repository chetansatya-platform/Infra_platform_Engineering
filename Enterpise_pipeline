pipeline {
    agent { label 'docker-node' }

    options {
        disableConcurrentBuilds()
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        timeout(time: 45, unit: 'MINUTES')
    }

    tools {
        nodejs 'nodejs'
        jdk 'java'
    }

    environment {
        APP_NAME            = 'zomato'
        SONAR_SCANNER_HOME  = tool 'mysonar'
        IMAGE_REPO          = 'chetansatya/myrepo'
        IMAGE_TAG           = "${env.BUILD_NUMBER}-${env.GIT_COMMIT ?: 'manual'}"
        IMAGE_NAME          = "${IMAGE_REPO}:${BUILD_NUMBER}"
        DOCKER_REGISTRY     = 'https://index.docker.io/v1/'
        TRIVY_SEVERITY      = 'CRITICAL,HIGH'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/devops0014/Zomato-Project.git'
                    ]]
                ])
                script {
                    env.GIT_SHORT_COMMIT = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()
                    env.IMAGE_NAME = "${IMAGE_REPO}:${BUILD_NUMBER}-${GIT_SHORT_COMMIT}"
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    set -euxo pipefail
                    node --version
                    npm --version
                    npm ci
                '''
            }
        }

        stage('Lint') {
            steps {
                sh '''
                    set -euxo pipefail
                    if npm run | grep -q " lint"; then
                      npm run lint
                    else
                      echo "No lint script found, skipping."
                    fi
                '''
            }
        }

        stage('Unit Tests') {
            steps {
                sh '''
                    set -euxo pipefail
                    if npm run | grep -q " test"; then
                      npm test -- --ci --reporters=default || npm test
                    else
                      echo "No test script found, skipping."
                    fi
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('mysonar') {
                    sh '''
                        set -euxo pipefail
                        ${SONAR_SCANNER_HOME}/bin/sonar-scanner \
                          -Dsonar.projectKey=zomato \
                          -Dsonar.projectName=zomato \
                          -Dsonar.sources=. \
                          -Dsonar.exclusions=node_modules/**,coverage/**,dist/**,build/**
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Dependency Check') {
            steps {
                dependencyCheck(
                    odcInstallation: 'dp-check',
                    additionalArguments: '''
                        --scan . \
                        --format XML \
                        --format HTML \
                        --out .
                    ''',
                    stopBuild: true
                )
            }
            post {
                always {
                    dependencyCheckPublisher(
                        pattern: '**/dependency-check-report.xml',
                        failedTotalHigh: 1,
                        stopBuild: true
                    )
                }
            }
        }

        stage('Build Application') {
            steps {
                sh '''
                    set -euxo pipefail
                    if npm run | grep -q " build"; then
                      npm run build
                    else
                      echo "No build script found, skipping."
                    fi
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -euxo pipefail
                    docker build -t ${IMAGE_NAME} .
                    docker tag ${IMAGE_NAME} ${IMAGE_REPO}:latest
                '''
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                sh '''
                    set -euxo pipefail
                    trivy fs \
                      --severity ${TRIVY_SEVERITY} \
                      --exit-code 1 \
                      --no-progress \
                      .
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    set -euxo pipefail
                    trivy image \
                      --severity ${TRIVY_SEVERITY} \
                      --exit-code 1 \
                      --no-progress \
                      ${IMAGE_NAME}
                '''
            }
        }

        stage('Push Docker Image') {
            when {
                branch 'main'
            }
            steps {
                script {
                    withDockerRegistry(credentialsId: 'dockerhub', url: "${DOCKER_REGISTRY}") {
                        sh '''
                            set -euxo pipefail
                            docker push ${IMAGE_NAME}
                            docker push ${IMAGE_REPO}:latest
                        '''
                    }
                }
            }
        }

        stage('Deploy') {
            when {
                branch 'main'
            }
            steps {
                sh '''
                    set -euxo pipefail

                    if docker service ls --format '{{.Name}}' | grep -wq zomato; then
                      docker service update \
                        --image ${IMAGE_NAME} \
                        --publish-rm 3000:3000 \
                        --publish-add 3000:3000 \
                        zomato
                    else
                      docker service create \
                        --name zomato \
                        --replicas 3 \
                        --publish 3000:3000 \
                        ${IMAGE_NAME}
                    fi
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'dependency-check-report.*, trivy*.txt', allowEmptyArchive: true
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
        success {
            echo "Pipeline completed successfully: ${IMAGE_NAME}"
        }
        failure {
            echo "Pipeline failed. Check stage logs and published reports."
        }
    }
}
